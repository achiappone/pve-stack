[Unit]
Description=Proxmox ops dashboard (Dev-Ops, TypeScript)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/pve-ops.env
WorkingDirectory=/opt/pve-ops
ExecStart=/usr/bin/node /opt/pve-ops/dist/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# ProtectSystem=strict makes /var/lib read-only; this punches a hole for the
# thermal history and down counters and creates /var/lib/pve-ops on start.
StateDirectory=pve-ops
ProtectHome=true

[Install]
WantedBy=multi-user.target
