#!/bin/bash
# Pull pve-stack from GitHub and install it to the host and the containers.
#
# Runs on the HOST, not in a container: installing into containers needs
# `pct push` / `pct exec`, and the PVE API has no file-push endpoint for LXC,
# so no container can do this job even with write permissions.
#
# Detached when triggered from the dashboard, because the last thing it does is
# restart the exporter that received the request. Holding the connection open
# would kill the response mid-flight and the click would look like a failure.
#
#   pve-deploy [branch]     default: main
set -uo pipefail
LOG=/var/log/pve-deploy.log
exec >>"$LOG" 2>&1

REPO=/opt/pve-stack
BRANCH="${1:-main}"

# Explicit key, not /root/.ssh/config. The exporter unit sets ProtectHome=true,
# so a deploy spawned from it cannot see /root at all - the ssh alias and key
# there are invisible and git fails with a DNS error that looks unrelated.
export GIT_SSH_COMMAND="ssh -i /etc/pve-deploy/key -o IdentitiesOnly=yes -o UserKnownHostsFile=/etc/pve-deploy/known_hosts"
echo "=== $(date -Is) deploy start (branch $BRANCH) ==="

git -C "$REPO" fetch --depth 1 origin "$BRANCH" || { echo "FAILED: fetch"; exit 1; }
OLD=$(git -C "$REPO" rev-parse --short HEAD 2>/dev/null || echo none)
git -C "$REPO" reset --hard "origin/$BRANCH" >/dev/null || { echo "FAILED: reset"; exit 1; }
NEW=$(git -C "$REPO" rev-parse --short HEAD)
echo "commit $OLD -> $NEW"
git -C "$REPO" --no-pager log --oneline -1

# This script deploys itself. Without re-exec, a run uses the OLD logic while
# installing the NEW script, so any change to what gets deployed only takes
# effect on the *next* invocation - which has twice produced a half-applied
# state (a node systemd unit installed with no dist/ to run, and an ops block
# silently skipped after a directory rename). Re-exec so one click lands fully.
if [ "${PVE_DEPLOY_REEXEC:-}" != "1" ] && ! cmp -s "$REPO/deploy/pve-deploy" /usr/local/sbin/pve-deploy; then
  install -m755 "$REPO/deploy/pve-deploy" /usr/local/sbin/pve-deploy
  echo "pve-deploy changed - re-executing the new one"
  PVE_DEPLOY_REEXEC=1 exec /usr/local/sbin/pve-deploy "$BRANCH"
fi

# Containers first. The exporter goes last because restarting it ends whatever
# connection asked for this deploy.
# ops dashboard: TypeScript, compiled. dist/ is committed so the container
# needs only a node runtime - the server has zero runtime dependencies, so
# there is no npm install to do on the box.
if [ -d "$REPO/ops/dist" ]; then
  pct exec 102 -- mkdir -p /opt/pve-ops/dist
  ok=1
  for f in "$REPO"/ops/dist/*.js; do
    pct push 102 "$f" "/opt/pve-ops/dist/$(basename "$f")" --perms 644 || ok=0
  done
  pct push 102 "$REPO/systemd/pve-ops.service" /etc/systemd/system/pve-ops.service || ok=0
  pct exec 102 -- systemctl daemon-reload
  pct exec 102 -- systemctl restart pve-ops || ok=0
  [ "$ok" = 1 ] && echo "ok: 102 pve-ops (typescript)" || echo "FAILED: 102 pve-ops"
fi

if [ -f "$REPO/camera/camrelay.py" ]; then
  pct push 101 "$REPO/camera/camrelay.py" /opt/camrelay.py --perms 755 \
    && pct push 101 "$REPO/systemd/camrelay.service" /etc/systemd/system/camrelay.service \
    && pct exec 101 -- systemctl daemon-reload \
    && echo "ok: 101 camrelay files" || echo "FAILED: 101 camrelay files"
  # Only restart it if it is enabled. camrelay runs headless Chromium against a
  # 1080p stream continuously and took this host to 98 C; it is deliberately
  # disabled until it becomes on-demand. An unconditional restart here silently
  # re-ignited that after every deploy.
  if pct exec 101 -- systemctl is-enabled camrelay >/dev/null 2>&1; then
    pct exec 101 -- systemctl restart camrelay && echo "ok: 101 camrelay restarted"
  else
    echo "skip: 101 camrelay is disabled - not starting it"
  fi
fi

for f in k2-deploy k2-set-smtp pve-deploy; do
  [ -f "$REPO/deploy/$f" ] && install -m755 "$REPO/deploy/$f" "/usr/local/sbin/$f" && echo "ok: /usr/local/sbin/$f"
done
[ -f "$REPO/deploy/pve-fstrim.cron" ] && install -m644 "$REPO/deploy/pve-fstrim.cron" /etc/cron.d/pve-fstrim && echo "ok: fstrim cron"

# Fan control needs force=1 on this model. Installed but never auto-applied:
# reloading the module is what makes it take effect, and doing that from a
# deploy would drop the hwmon device out from under the running exporter.
for f in "$REPO"/modprobe.d/*.conf; do
  [ -f "$f" ] || continue
  install -m644 "$f" "/etc/modprobe.d/$(basename "$f")" \
    && echo "ok: modprobe.d/$(basename "$f") (takes effect on module reload or reboot)"
done

install -m755 "$REPO/exporter/pve-exporter.py" /usr/local/sbin/pve-exporter.py && echo "ok: exporter"
install -m644 "$REPO/systemd/pve-exporter.service" /etc/systemd/system/pve-exporter.service
systemctl daemon-reload
echo "=== $(date -Is) deploy done at $NEW - restarting exporter ==="
systemctl restart pve-exporter
